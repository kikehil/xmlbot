```ejs
<!DOCTYPE html>
<html lang="es">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>CFDIBOOT</title>

<style>

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

body{
  background:#020617;
  color:white;
  font-family:Arial;
  padding:30px;
}

.top{
  display:flex;
  justify-content:space-between;
  align-items:flex-start;
  margin-bottom:30px;
}

.title{
  font-size:42px;
  font-weight:bold;
}

.dropzone{
  border:2px dashed #38bdf8;
  padding:40px;
  border-radius:20px;
  text-align:center;
  margin-bottom:30px;
  background:#0f172a;
  transition:.3s;
}

.dropzone.dragover{
  background:#1e293b;
}

.cards{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
  gap:20px;
  margin-bottom:30px;
}

.card{
  background:#0f172a;
  padding:25px;
  border-radius:20px;
}

.card h3{
  color:#94a3b8;
  margin-bottom:10px;
}

.value{
  font-size:35px;
  font-weight:bold;
}

.green{
  color:#22c55e;
}

.blue{
  color:#38bdf8;
}

.purple{
  color:#c084fc;
}

.search-tools{
  display:flex;
  gap:12px;
  align-items:center;
  margin-bottom:20px;
}

.search-tools input{
  background:#111c3d;
  border:none;
  padding:14px 18px;
  border-radius:14px;
  color:white;
  width:260px;
  outline:none;
}

.search-tools button{
  background:#111c3d;
  border:none;
  color:white;
  padding:14px 18px;
  border-radius:14px;
  cursor:pointer;
  font-weight:600;
}

#columnsPanel{
  display:none;
  margin-top:15px;
  background:#0f172e;
  padding:20px;
  border-radius:16px;
  border:1px solid rgba(255,255,255,.05);
  color:white;
}

#columnsPanel label{
  display:block;
  margin-bottom:10px;
}

table{
  width:100%;
  border-collapse:collapse;
  background:#0f172a;
  border-radius:20px;
  overflow:hidden;
}

th{
  background:#111827;
  padding:18px;
  text-align:left;
}

td{
  padding:18px;
  border-bottom:1px solid #1e293b;
}

tr:hover{
  background:#1e293b;
}

.total{
  color:#22c55e;
  font-weight:bold;
}

.detalle-row{
  display:none;
  background:#07152d;
}

.detalle-box{
  padding:20px;
}

.conceptos-table{
  width:100%;
  border-collapse:collapse;
  margin-top:15px;
}

.conceptos-table th{
  text-align:left;
  padding:12px;
  color:#8fb4ff;
  border-bottom:1px solid rgba(255,255,255,.08);
}

.conceptos-table td{
  padding:12px;
  border-bottom:1px solid rgba(255,255,255,.05);
  color:white;
}

.factura-row{
  cursor:pointer;
  transition:.2s;
}

.factura-row:hover{
  background:rgba(255,255,255,.03);
}

</style>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

</head>

<body>

<div class="top">

  <div class="title">
    🚀 CFDIBOOT
  </div>

  <div>

    <div class="search-tools">

      <input
        type="text"
        id="searchInput"
        placeholder="Buscar..."
      />

      <button onclick="toggleColumnsPanel()">
        ⚙️ Columnas
      </button>

    </div>

    <div id="columnsPanel">

      <label>
        <input type="checkbox" checked data-column="uuid">
        UUID
      </label>

      <label>
        <input type="checkbox" checked data-column="emisor">
        Emisor
      </label>

      <label>
        <input type="checkbox" checked data-column="receptor">
        Receptor
      </label>

      <label>
        <input type="checkbox" checked data-column="total">
        Total
      </label>

    </div>

  </div>

</div>

<div class="dropzone" id="dropzone">

  <h2>📂 Arrastra XMLs aquí</h2>
  <br>
  <p>o haz click para subir</p>

  <input
    type="file"
    id="fileInput"
    hidden
    accept=".xml"
  >

</div>

<div class="cards">

  <div class="card">
    <h3>Total Facturas</h3>
    <div class="value blue">
      <%= facturas.length %>
    </div>
  </div>

  <div class="card">
    <h3>Total Procesado</h3>
    <div class="value green">
      $
      <%= facturas
        .reduce((acc, f) => acc + parseFloat(f.total || 0), 0)
        .toLocaleString() %>
    </div>
  </div>

  <div class="card">
    <h3>Servidor</h3>
    <div class="value purple">
      ONLINE
    </div>
  </div>

</div>

<table id="tabla">

<thead>
<tr>
  <th>ID</th>
  <th class="col-uuid">UUID</th>
  <th class="col-emisor">Emisor</th>
  <th class="col-receptor">Receptor</th>
  <th class="col-total">Total</th>
</tr>
</thead>

<tbody>

<% facturas.forEach(f => { %>

<tr class="factura-row" onclick="toggleDetalle(<%= f.id %>)">

  <td><%= f.id %></td>

  <td class="col-uuid">
    <%= f.uuid %>
  </td>

  <td class="col-emisor">
    <%= f.emisor %>
  </td>

  <td class="col-receptor">
    <%= f.receptor %>
  </td>

  <td class="col-total total">
    $ <%= Number(f.total).toLocaleString() %>
  </td>

</tr>

<tr id="detalle-<%= f.id %>" class="detalle-row">

  <td colspan="5">

    <div class="detalle-box">

      <h3 style="margin-bottom:15px;">
        📦 Conceptos XML
      </h3>

      <table class="conceptos-table">

        <thead>
          <tr>
            <th>Clave SAT</th>
            <th>Descripción</th>
            <th>Cantidad</th>
            <th>Unidad</th>
            <th>Valor Unitario</th>
            <th>Importe</th>
          </tr>
        </thead>

        <tbody>

        <% if(f.conceptos && f.conceptos.length){ %>

          <% f.conceptos.forEach(c => { %>

          <tr>
            <td><%= c.clave_sat %></td>
            <td><%= c.descripcion %></td>
            <td><%= c.cantidad %></td>
            <td><%= c.unidad %></td>
            <td>$ <%= Number(c.valor_unitario).toLocaleString() %></td>
            <td>$ <%= Number(c.importe).toLocaleString() %></td>
          </tr>

          <% }) %>

        <% } else { %>

          <tr>
            <td colspan="6">
              Sin conceptos
            </td>
          </tr>

        <% } %>

        </tbody>

      </table>

    </div>

  </td>

</tr>

<% }) %>

</tbody>
</table>

<script>

function toggleDetalle(id){

  const row = document.getElementById(`detalle-${id}`);

  if(row.style.display === 'table-row'){
    row.style.display = 'none';
  }else{
    row.style.display = 'table-row';
  }

}

function toggleColumnsPanel(){

  const panel = document.getElementById('columnsPanel');

  panel.style.display =
    panel.style.display === 'block'
      ? 'none'
      : 'block';

}

document
.querySelectorAll('#columnsPanel input')
.forEach(input => {

  input.addEventListener('change', () => {

    const column = input.dataset.column;

    document
    .querySelectorAll('.col-' + column)
    .forEach(el => {

      el.style.display =
        input.checked
          ? ''
          : 'none';

    });

  });

});

const dropzone = document.getElementById('dropzone');
const fileInput = document.getElementById('fileInput');

dropzone.addEventListener('click', () => {
  fileInput.click();
});

dropzone.addEventListener('dragover', (e) => {

  e.preventDefault();
  dropzone.classList.add('dragover');

});

dropzone.addEventListener('dragleave', () => {
  dropzone.classList.remove('dragover');
});

dropzone.addEventListener('drop', async (e) => {

  e.preventDefault();

  dropzone.classList.remove('dragover');

  const file = e.dataTransfer.files[0];

  uploadXML(file);

});

fileInput.addEventListener('change', () => {
  uploadXML(fileInput.files[0]);
});

async function uploadXML(file){

  const formData = new FormData();

  formData.append('xml', file);

  const response = await fetch('/upload-xml', {
    method:'POST',
    body:formData
  });

  const result = await response.json();

  Swal.fire({

    icon: result.ok ? 'success' : 'warning',

    title: result.ok
      ? 'Éxito 🚀'
      : 'Atención ⚠️',

    text: result.mensaje || result.error,

    background:'#0f172a',

    color:'#fff',

    confirmButtonColor:'#22c55e'

  });

  setTimeout(() => {
    location.reload();
  }, 1000);

}

</script>

</body>
</html>
```
